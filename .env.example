# TradePilot AI Configuration Environment Variables
# DEMO-ONLY Autonomous Forex Trading Platform

# Platform & Mode
APP_NAME="TradePilot AI"
ENVIRONMENT="development"
TRADING_MODE="demo"
LIVE_TRADING_ENABLED="false"

# Allowed Symbols (Comma-separated)
ALLOWED_SYMBOLS="EURUSD"
DEFAULT_SYMBOL="EURUSD"
DEFAULT_TIMEFRAME="M15"
HTF_TIMEFRAME="H1"

# MetaTrader 5 Credentials & Settings (Leave blank to use active MT5 desktop terminal or mock mode)
MT5_PATH=""
MT5_LOGIN=""
MT5_PASSWORD=""
MT5_SERVER=""
MT5_TIMEOUT_MS=60000
MT5_PORTABLE=false
MT5_USE_MOCK_FALLBACK=true
MT5_SYMBOL_MAP={"EURUSD":"EURUSD"}

# Strict Demo Risk Safeguards (Configurable baseline)
MAX_RISK_PER_TRADE_PCT=0.25
MAX_TOTAL_OPEN_RISK_PCT=0.50
MAX_DAILY_LOSS_PCT=1.0
MAX_WEEKLY_LOSS_PCT=3.0
MAX_CONSECUTIVE_LOSSES=3
MAX_TRADES_PER_DAY=5
MAX_SPREAD_PIPS=2.5
SLIPPAGE_TOLERANCE_POINTS=10

# AI Provider Configuration (Options: local_fallback, openai, gemini, claude, ollama)
AI_PROVIDER="local_fallback"
AI_API_KEY=""
AI_API_BASE=""
AI_MODEL_NAME="tradepilot-deterministic-v1"
AI_TIMEOUT_SECONDS=15

# Database & Engine Settings
DATABASE_URL="sqlite:///./data/tradepilot.db"
EVALUATION_INTERVAL_SECONDS=10
AUTO_RECONCILE_INTERVAL_SECONDS=30
SECRET_KEY="replace-with-a-secure-random-key-in-production"
AUTH_API_TOKEN=""
API_HOST="127.0.0.1"
API_PORT=8000
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"
